        "import pandas as pd\n",
        "import zipfile\n",
        "from collections import Counter\n",
        "\n",
        "# ====================================================\n",
        "# 1. CHARGER LE DATASET RETAIL\n",
        "# ====================================================\n",
        "\n",
        "zip_path = 'Retail Data Analytics dataset.zip'\n",
        "\n",
        "with zipfile.ZipFile(zip_path, 'r') as z:\n",
        "    print(\"Fichiers dans le ZIP :\")\n",
        "    print(z.namelist())\n",
        "\n",
        "    sales_df = pd.read_csv(\n",
        "        z.open('Retail Data Analytics dataset/sales data-set.csv')\n",
        "    )\n",
        "\n",
        "    stores_df = pd.read_csv(\n",
        "        z.open('Retail Data Analytics dataset/stores data-set.csv')\n",
        "    )\n",
        "\n",
        "    features_df = pd.read_csv(\n",
        "        z.open('Retail Data Analytics dataset/Features data set.csv')\n",
        "    )\n",
        "\n",
        "# ====================================================\n",
        "# 2. CHARGER LE DATASET WOMEN REVIEWS\n",
        "# ====================================================\n",
        "\n",
        "df2 = pd.read_csv(\n",
        "    \"Women's E-Commerce Clothing Reviews.zip\",\n",
        "    compression='zip'\n",
        ")\n",
        "\n",
        "# ====================================================\n",
        "# 3. ANALYSE RETAIL\n",
        "# ====================================================\n",
        "\n",
        "print(\"\\n===== ANALYSE RETAIL =====\")\n",
        "\n",
        "print(\"Moyenne des ventes :\")\n",
        "print(sales_df['Weekly_Sales'].mean())\n",
        "\n",
        "print(\"\\nMédiane des ventes :\")\n",
        "print(sales_df['Weekly_Sales'].median())\n",
        "\n",
        "print(\"\\nÉcart type des ventes :\")\n",
        "print(sales_df['Weekly_Sales'].std())\n",
        "\n",
        "print(\"\\nTop magasins performants :\")\n",
        "store_perf = sales_df.groupby('Store')['Weekly_Sales'].sum()\n",
        "print(store_perf.sort_values(ascending=False).head())\n",
        "\n",
        "# ====================================================\n",
        "# 4. ANALYSE WOMEN REVIEWS\n",
        "# ====================================================\n",
        "\n",
        "print(\"\\n===== ANALYSE WOMEN REVIEWS =====\")\n",
        "\n",
        "print(\"Satisfaction moyenne des clientes :\")\n",
        "print(df2['Rating'].mean())\n",
        "\n",
        "# Analyse de sentiment simple\n",
        "def sentiment(note):\n",
        "    if note >= 4:\n",
        "        return \"Positif\"\n",
        "    elif note == 3:\n",
        "        return \"Neutre\"\n",
        "    else:\n",
        "        return \"Négatif\"\n",
        "\n",
        "df2['Sentiment'] = df2['Rating'].apply(sentiment)\n",
        "\n",
        "print(\"\\nSentiments prédominants :\")\n",
        "print(df2['Sentiment'].value_counts())\n",
        "\n",
        "# Mots fréquents dans les avis\n",
        "text = \" \".join(\n",
        "    df2['Review Text']\n",
        "    .dropna()\n",
        "    .astype(str)\n",
        ")\n",
        "\n",
        "words = text.lower().split()\n",
        "\n",
        "common_words = Counter(words).most_common(10)\n",
        "\n",
        "print(\"\\nMots les plus fréquents :\")\n",
        "print(common_words)\n",
        "\n",
        "# ====================================================\n",
        "# 5. COMPARAISON\n",
        "# ====================================================\n",
        "\n",
        "print(\"\\n===== COMPARAISON =====\")\n",
        "\n",
        "print(\"\"\"\n",
        "Retail (données structurées) :\n",
        "- tendances des ventes faciles à analyser,\n",
        "- performance des magasins identifiable,\n",
        "- habitudes d'achat observables.\n",
